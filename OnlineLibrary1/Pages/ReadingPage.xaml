<Page x:Class="OnlineLibrary1.Pages.ReadingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:OnlineLibrary1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ReadingPage">

    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#4a6fa5" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="◀ Назад"
                        Click="BackButton_Click"
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="16"
                        Padding="10,4"/>

                <TextBlock x:Name="BookTitleText"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="20,0"/>

                <Button Content="В каталог"
                        Click="ExitButton_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="White"
                        FontSize="16"
                        Padding="10,4"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Margin="25" Padding="25" Background="White" CornerRadius="8">
            <ScrollViewer x:Name="BookScrollViewer" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="BookContentText"
                           FontSize="18"
                           LineHeight="30"
                           TextWrapping="Wrap"
                           TextAlignment="Justify"/>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2" Background="#f5f5f5" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Content="⏮"
                        Click="FirstPage_Click"
                        Margin="0,0,10,0"
                        Padding="10,4"/>

                <Button Content="◀"
                        Click="PrevPage_Click"
                        Margin="0,0,10,0"
                        Padding="10,4"/>

                <TextBox x:Name="PageNumberText"
                         Width="60"
                         Height="30"
                         TextAlignment="Center"
                         VerticalContentAlignment="Center"
                         VerticalAlignment="Center"
                         Margin="0,0,10,0"
                         Text="1"
                         KeyDown="PageNumberText_KeyDown"/>

                <TextBlock x:Name="TotalPagesText"
                           Text="/ 1"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"
                           FontSize="16"/>

                <Button Content="▶"
                        Click="NextPage_Click"
                        Margin="0,0,10,0"
                        Padding="10,4"/>

                <Button Content="⏭"
                        Click="LastPage_Click"
                        Padding="10,4"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
