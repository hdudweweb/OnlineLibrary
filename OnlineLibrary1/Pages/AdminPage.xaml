<Page x:Class="OnlineLibrary1.Pages.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:OnlineLibrary1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AdminPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="White" CornerRadius="10" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Панель администратора" FontSize="24" FontWeight="Bold"/>
                <TextBlock Text="Управление пользователями и книгами" Foreground="Gray" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Пользователи" FontSize="20" FontWeight="SemiBold"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,12">
                    <TextBox x:Name="UserSearchTextBox" Width="280" Height="32" VerticalContentAlignment="Center" TextChanged="UserSearchTextBox_TextChanged"/>
                    <Button Content="Обновить" Width="120" Margin="8,0,0,0" Click="RefreshUsers_Click"/>
                    <Button Content="Выдать админку" Width="140" Margin="8,0,0,0" Click="PromoteUser_Click"/>
                    <Button Content="Снять админку" Width="140" Margin="8,0,0,0" Click="DemoteUser_Click"/>
                    <Button Content="Удалить пользователя" Width="170" Margin="8,0,0,0" Background="#C0392B" Foreground="White" Click="DeleteUser_Click"/>
                </StackPanel>

                <DataGrid x:Name="UsersGrid"
                          Grid.Row="2"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding UserId}" Width="60"/>
                        <DataGridTextColumn Header="Имя" Binding="{Binding Username}" Width="*"/>
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="220"/>
                        <DataGridTextColumn Header="Роль" Binding="{Binding RoleName}" Width="150"/>
                        <DataGridTextColumn Header="Создан" Binding="{Binding CreatedText}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Книги" FontSize="20" FontWeight="SemiBold"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,12">
                    <TextBox x:Name="BookSearchTextBox" Width="280" Height="32" VerticalContentAlignment="Center" TextChanged="BookSearchTextBox_TextChanged"/>
                    <Button Content="Обновить" Width="120" Margin="8,0,0,0" Click="RefreshBooks_Click"/>
                    <Button Content="Удалить книгу" Width="150" Margin="8,0,0,0" Background="#C0392B" Foreground="White" Click="DeleteBook_Click"/>
                </StackPanel>

                <DataGrid x:Name="BooksGrid"
                          Grid.Row="2"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding BookId}" Width="60"/>
                        <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="*"/>
                        <DataGridTextColumn Header="Автор" Binding="{Binding Author}" Width="240"/>
                        <DataGridTextColumn Header="Жанр" Binding="{Binding Genre}" Width="170"/>
                        <DataGridTextColumn Header="Год" Binding="{Binding Year}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    
    </Grid>
</Page>
